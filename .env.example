# ── Required in production ─────────────────────────────────────────────
# Postgres connection string (Supabase: Project Settings → Database → connection pooler URI).
# Unset in local dev → an embedded PGlite database is created in ./.data
DATABASE_URL=
# 32+ random bytes, signs session cookies and login nonces.  openssl rand -hex 32
SESSION_SECRET=
# Mainnet RPC used by the server (Helius/Triton recommended; the public RPC rate-limits hard).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Public site origin, used in sign-in messages (domain binding).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ── Optional ──────────────────────────────────────────────────────────
# Helius key: enables exact holder counts (DAS getTokenAccounts). Without it holder counts show "—".
HELIUS_API_KEY=
# Meteora Dynamic Bonding Curve: the platform config account (create once: npm run dbc:config).
# Unset → Meteora launches are shown as "not configured", never faked.
DBC_CONFIG=
# Pinata JWT for metadata uploads. Unset → pump.fun's public IPFS endpoint is used.
PINATA_JWT=
